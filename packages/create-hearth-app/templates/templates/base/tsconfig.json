{
  "schema": "https://json.schemastore.org/tsconfig",
  "extends": "@open-hearth/tsconfig/next-app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
